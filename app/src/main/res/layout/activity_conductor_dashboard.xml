<?xml version="1.0" encoding="utf-8"?>
<!--
    Bus Corp. — Conductor Dashboard
    Theme: Dark #0A0F1C, surface #111827, neon-blue primary #2563EB, gold #F59E0B
    Architecture: Firebase RTDB for AlightRequests + live stats. Supabase for tickets/history.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F1C"
    tools:context=".ConductorDashboardActivity">

    <!-- ===== STATUS BAR SPACER ===== -->
    <View
        android:id="@+id/statusBarSpacer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===== SCROLL CONTAINER ===== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="96dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp">

            <!-- ===== HEADER ROW ===== -->
            <LinearLayout
                android:id="@+id/headerRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bus Corp."
                        android:textColor="#F59E0B"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.15"/>

                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Good morning,"
                        android:textColor="#9CA3AF"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp"/>

                    <TextView
                        android:id="@+id/tvUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Conductor"
                        android:textColor="#F9FAFB"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="Ana Reyes"/>
                </LinearLayout>

                <!-- Sync badge -->
                <LinearLayout
                    android:id="@+id/syncBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/badge_glass_bg"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp">

                    <View
                        android:id="@+id/syncDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/circle_green_pulse"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LIVE"
                        android:textColor="#10B981"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== HERO CARD — TRIP STATUS (Gyro-Parallax via MotionLayout) ===== -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardTripStatus"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginBottom="16dp"
                android:alpha="0.0"
                android:translationY="60dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="16dp"
                app:cardBackgroundColor="#111827">

                <!-- Gradient overlay -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/gradient_hero_card"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Route label -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_directions_bus"
                            app:tint="#2563EB"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:id="@+id/tvCurrentRoute"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="No active trip"
                            android:textColor="#9CA3AF"
                            android:textSize="13sp"
                            tools:text="FVR Terminal → GMA Kamuning"/>

                        <!-- Density badge -->
                        <TextView
                            android:id="@+id/tvDensityBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NORMAL"
                            android:textColor="#F59E0B"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:background="@drawable/badge_gold_outline"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"/>
                    </LinearLayout>

                    <!-- Bus number large display -->
                    <TextView
                        android:id="@+id/tvBusNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BUS ---"
                        android:textColor="#F9FAFB"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"
                        tools:text="BUS 101"/>

                    <!-- Trip progress bar -->
                    <ProgressBar
                        android:id="@+id/progressTrip"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:progress="45"
                        android:max="100"
                        android:progressTint="#2563EB"
                        android:progressBackgroundTint="#1F2937"
                        android:layout_marginBottom="8dp"/>

                    <!-- ETA row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvEta"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="ETA: --"
                            android:textColor="#6B7280"
                            android:textSize="12sp"
                            tools:text="ETA: 14 min"/>

                        <TextView
                            android:id="@+id/tvDistance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-- km"
                            android:textColor="#6B7280"
                            android:textSize="12sp"
                            tools:text="8.4 km remaining"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ===== ALIGHT NOTIFICATION BANNER (Firebase RTDB: POS_Devices/{serial}/AlightRequests) ===== -->
            <androidx.cardview.widget.CardView
                android:id="@+id/panelAlightNotification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:alpha="0.0"
                android:translationY="60dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#1F1A0A">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">

                    <!-- Animated pulse icon -->
                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/lottieAlightPulse"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        app:lottie_rawRes="@raw/lottie_alight_bell"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="true"
                        android:layout_marginEnd="12dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚡ ALIGHT ALERT"
                            android:textColor="#F59E0B"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1"/>

                        <TextView
                            android:id="@+id/tvAlightMessage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Monitoring passenger stops…"
                            android:textColor="#F9FAFB"
                            android:textSize="14sp"
                            android:layout_marginTop="2dp"
                            tools:text="Passenger requesting alight at SM Fairview"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ===== KPI TILES ROW ===== -->
            <LinearLayout
                android:id="@+id/rowKpi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp"
                android:alpha="0.0"
                android:translationY="60dp">

                <!-- Tickets Today -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="8dp"
                    app:cardBackgroundColor="#111827">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvTicketsToday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#2563EB"
                            android:textSize="26sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tickets"
                            android:textColor="#6B7280"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Cash Total -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="8dp"
                    app:cardBackgroundColor="#111827">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvLiveCash"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₱0"
                            android:textColor="#10B981"
                            android:textSize="20sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cash"
                            android:textColor="#6B7280"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- GCash Total -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="8dp"
                    app:cardBackgroundColor="#111827">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvLiveGcash"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₱0"
                            android:textColor="#007DFE"
                            android:textSize="20sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GCash"
                            android:textColor="#6B7280"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- ===== SECTION LABEL ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick Actions"
                android:textColor="#F9FAFB"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="14dp"/>

            <!-- ===== QUICK ACTION GRID ===== -->
            <GridLayout
                android:id="@+id/gridActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:layout_marginBottom="16dp"
                android:alpha="0.0"
                android:translationY="60dp">

                <!-- Issue Ticket -->
                <LinearLayout
                    android:id="@+id/btnIssueTicket"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="6dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/card_action_primary"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_ticket"
                        app:tint="#FFFFFF"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Issue Ticket"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- QR Scanner -->
                <LinearLayout
                    android:id="@+id/btnScanner"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="6dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/card_action_surface"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_qr_scanner"
                        app:tint="#2563EB"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Scan QR"
                        android:textColor="#F9FAFB"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- Live Map -->
                <LinearLayout
                    android:id="@+id/btnViewMap"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="6dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/card_action_surface"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_map_marker"
                        app:tint="#10B981"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Live Map"
                        android:textColor="#F9FAFB"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- Remittance -->
                <LinearLayout
                    android:id="@+id/btnRemit"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="6dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/card_action_surface"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_remittance"
                        app:tint="#F59E0B"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Remittance"
                        android:textColor="#F9FAFB"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </GridLayout>

            <!-- ===== SYNC STATUS CARD ===== -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSyncStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:alpha="0.0"
                android:translationY="60dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#0D1117">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <View
                        android:id="@+id/dotSyncStatus"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/circle_green_pulse"
                        android:layout_marginEnd="12dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Synced with Command Center"
                            android:textColor="#F9FAFB"
                            android:textSize="13sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvLastSyncTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Last sync: just now"
                            android:textColor="#6B7280"
                            android:textSize="11sp"/>
                    </LinearLayout>

                    <!-- Offline queue badge (hidden when synced) -->
                    <TextView
                        android:id="@+id/tvOfflineQueueCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 queued"
                        android:textColor="#EF4444"
                        android:textSize="11sp"
                        android:visibility="gone"
                        tools:visibility="visible"
                        tools:text="3 queued"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===== BOTTOM NAVIGATION ===== -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="#111827"
        app:itemIconTint="@color/nav_icon_tint"
        app:itemTextColor="@color/nav_icon_tint"
        app:menu="@menu/menu_conductor_nav"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>