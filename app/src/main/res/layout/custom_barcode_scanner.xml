<?xml version="1.0" encoding="utf-8"?>
<!-- Custom ZXing Scanner Layout to include our Neon Beam -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
       xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.journeyapps.barcodescanner.BarcodeView
        android:id="@+id/zxing_barcode_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.journeyapps.barcodescanner.ViewfinderView
        android:id="@+id/zxing_viewfinder_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:zxing_possible_result_points="@color/buscorp_cyan"
        app:zxing_result_view="@color/buscorp_cyan_20"
        app:zxing_viewfinder_laser="@color/buscorp_cyan"
        app:zxing_viewfinder_mask="#990A111F"/>
        
    <!-- Custom Neon Beam Container inside Viewfinder area -->
    <FrameLayout
        android:id="@+id/scanFrame"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_gravity="center">
        
        <!-- Glowing Borders -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_passenger_type_active"
            android:alpha="0.5"/>

        <!-- The Animated Beam -->
        <View
            android:id="@+id/neonBeam"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="@drawable/splash_neon_underline"
            android:translationY="0dp"/>
            
    </FrameLayout>

    <TextView
        android:id="@+id/zxing_status_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="100dp"
        android:text=""
        android:textColor="@color/text_primary"
        android:visibility="gone"/>

</merge>
