<?xml version="1.0" encoding="utf-8"?>
<!--
    Bus Corp. Ticketing Screen
    Theme: Glassmorphism, Dark #0A111F (Navy)
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/buscorp_background"
    tools:context=".TicketActivity">

    <!-- Ambient Glowing Orbs -->
    <View
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:background="@drawable/splash_glow_radial"
        android:alpha="0.2"
        android:translationX="-100dp"
        android:translationY="-100dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
        
    <View
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:background="@drawable/splash_glow_radial"
        android:alpha="0.15"
        android:translationX="100dp"
        android:translationY="300dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">
            
            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">
                
                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@drawable/btn_back_selector"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/text_primary"/>
                    
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Issue Ticket"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center"/>
                    
                <View
                    android:layout_width="40dp"
                    android:layout_height="40dp"/> <!-- Spacer to center title -->
            </LinearLayout>

            <!-- Route Selection Glass Panel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/glass_panel_login"
                android:padding="20dp"
                android:layout_marginBottom="24dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Route Details"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="12dp"/>
                    
                <!-- Origin -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Origin"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:boxBackgroundColor="@color/buscorp_surface2"
                    app:boxStrokeColor="@color/buscorp_divider"
                    android:layout_marginBottom="16dp">
                    <AutoCompleteTextView
                        android:id="@+id/spinnerOrigin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textColor="@color/text_primary"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Destination -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Destination"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:boxBackgroundColor="@color/buscorp_surface2"
                    app:boxStrokeColor="@color/buscorp_divider">
                    <AutoCompleteTextView
                        android:id="@+id/spinnerDestination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textColor="@color/text_primary"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Passenger Type Grid -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Passenger Type"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:layout_marginBottom="32dp">

                <LinearLayout
                    android:id="@+id/btnTypeRegular"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_passenger_type_active"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_person_tie" app:tint="@color/buscorp_cyan" android:layout_marginBottom="4dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Regular" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="14sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnTypeStudent"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_passenger_type_inactive"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_school" app:tint="@color/text_secondary" android:layout_marginBottom="4dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Student" android:textColor="@color/text_secondary" android:textStyle="bold" android:textSize="14sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnTypeSenior"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_passenger_type_inactive"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_elderly" app:tint="@color/text_secondary" android:layout_marginBottom="4dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Senior" android:textColor="@color/text_secondary" android:textStyle="bold" android:textSize="14sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnTypePwd"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_passenger_type_inactive"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_elderly" app:tint="@color/text_secondary" android:layout_marginBottom="4dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PWD" android:textColor="@color/text_secondary" android:textStyle="bold" android:textSize="14sp"/>
                </LinearLayout>

            </GridLayout>

            <!-- Spacer to push footer down -->
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>

            <!-- Fare Display -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">
                
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Total Fare"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp"/>
                    
                <TextView
                    android:id="@+id/tvCalculatedFare"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₱0.00"
                    android:textColor="@color/buscorp_cyan"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:shadowColor="@color/buscorp_cyan_20"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="16"/>
            </LinearLayout>

            <!-- Issue Ticket Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIssue"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Issue Ticket"
                android:textSize="16sp"
                app:cornerRadius="16dp"
                style="@style/Widget.BusCorp.Button.Primary"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Success Overlay -->
    <FrameLayout
        android:id="@+id/overlaySuccess"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D90A111F"
        android:visibility="gone"
        android:elevation="20dp">
        
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_gravity="center"
            android:background="@drawable/glass_panel_login"
            android:padding="32dp">
            
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieSuccess"
                android:layout_width="100dp"
                android:layout_height="100dp"
                app:lottie_rawRes="@raw/lottie_success"
                app:lottie_autoPlay="false"
                app:lottie_loop="false"
                android:layout_marginBottom="16dp"/>
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ticket Issued"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"/>
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saved offline and queued for sync."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>