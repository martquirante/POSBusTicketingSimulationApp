<?xml version="1.0" encoding="utf-8"?>
<!-- Hero card gradient — blue glow at top, dark body -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="#1A2563EB"
        android:centerColor="#0D111827"
        android:endColor="#0A0F1C"/>
    <corners android:radius="20dp"/>
</shape>
